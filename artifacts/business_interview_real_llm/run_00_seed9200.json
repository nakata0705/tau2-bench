  "conversation": [],
  "observations": [
    {
      "id": "obs_3",
      "source_id": "stakeholder",
      "text": "The process starts when I receive the quotation request. That's the first step, and I'm the one who handles it.",
      "order": 0,
      "turn": 3
    },
    {
      "id": "obs_14",
      "source_id": "stakeholder",
      "text": "I'm a sales employee, so I'm the one who handles the quotation requests and prepares the quotations.",
      "order": 1,
      "turn": 14
    },
    {
      "id": "obs_25",
      "source_id": "stakeholder",
      "text": "After I receive the request, I check the customer information in the CRM.",
      "order": 2,
      "turn": 25
    },
    {
      "id": "obs_39",
      "source_id": "stakeholder",
      "text": "After I check the customer information, I create the quotation using the quoting system, pulling in the pricing information as well.",
      "order": 3,
      "turn": 39
    },
    {
      "id": "obs_54",
      "source_id": "stakeholder",
      "text": "After I create the quotation, it depends on the amount. If it's over 1,000,000 yen, the manager needs to approve it. If it's at or below 1,000,000 yen, I send it directly to the customer. Also, at month-end, I send a summary of the quotation information to Accounting using Excel.",
      "order": 4,
      "turn": 54
    },
    {
      "id": "obs_79",
      "source_id": "stakeholder",
      "text": "After the manager approves the high-value quotation, I send it to the customer via email.",
      "order": 5,
      "turn": 79
    }
  ],
