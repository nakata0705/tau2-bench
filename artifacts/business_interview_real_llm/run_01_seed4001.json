  "conversation": [],
  "observations": [
    {
      "id": "obs_3",
      "source_id": "stakeholder",
      "text": "The process starts when we receive the customer's quotation request. After that, I check the customer information in the CRM, then I create the quotation document using the pricing information. If the quotation amount is over 1,000,000 yen, it goes to the manager for approval, which is for credit risk management. Otherwise, if it's at or below 1,000,000 yen, we send it directly to the customer via email. Also, at month-end, I send a summary of the quotation information to Accounting using Excel.",
      "order": 0,
      "turn": 3
    }
  ],
